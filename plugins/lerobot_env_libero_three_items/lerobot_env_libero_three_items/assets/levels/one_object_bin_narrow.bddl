(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language put the red cube in the bin)
    (:regions
      (item_1_region
          (:target floor)
          (:ranges (
              (-0.105 -0.185 -0.095 -0.175)
            )
          )
      )
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.005 0.245 0.005 0.255)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    item_1 - cube_red
    basket_1 - bin_narrow
  )

  (:obj_of_interest
    item_1
    basket_1
  )

  (:init
    (On item_1 floor_item_1_region)
    (On basket_1 floor_basket_1_region)
  )

  (:goal
    (And (In item_1 basket_1_contain_region))
  )

)
