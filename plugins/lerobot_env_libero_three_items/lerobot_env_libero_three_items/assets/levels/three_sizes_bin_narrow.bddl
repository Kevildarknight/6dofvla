(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language put the small, the medium and the large cylinder in the bin)
    (:regions
      (item_1_region
          (:target floor)
          (:ranges (
              (-0.105 -0.185 -0.095 -0.175)
            )
          )
      )
      (item_2_region
          (:target floor)
          (:ranges (
              (0.055 -0.105 0.065 -0.095)
            )
          )
      )
      (item_3_region
          (:target floor)
          (:ranges (
              (-0.155 0.025 -0.145 0.035)
            )
          )
      )
      (basket_1_region
          (:target floor)
          (:ranges (
              (-0.005 0.245 0.005 0.255)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    item_1 - cylinder_small_red
    item_2 - cylinder_medium_red
    item_3 - cylinder_large_red
    basket_1 - bin_narrow
  )

  (:obj_of_interest
    item_1
    item_2
    item_3
    basket_1
  )

  (:init
    (On item_1 floor_item_1_region)
    (On item_2 floor_item_2_region)
    (On item_3 floor_item_3_region)
    (On basket_1 floor_basket_1_region)
  )

  (:goal
    (And (In item_1 basket_1_contain_region) (In item_2 basket_1_contain_region) (In item_3 basket_1_contain_region))
  )

)
