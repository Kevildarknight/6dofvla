(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language put all three items in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (item_1_region
          (:target floor)
          (:ranges (
              (-0.172 -0.182 -0.168 -0.178)
            )
          )
      )
      (item_2_region
          (:target floor)
          (:ranges (
              (-0.002 -0.182 0.002 -0.178)
            )
          )
      )
      (item_3_region
          (:target floor)
          (:ranges (
              (0.168 -0.182 0.172 -0.178)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    item_1 - ketchup
    item_2 - ketchup
    item_3 - ketchup
    basket_1 - basket
  )

  (:obj_of_interest
    item_1
    item_2
    item_3
    basket_1
  )

  (:init
    (On item_1 floor_item_1_region)
    (On item_2 floor_item_2_region)
    (On item_3 floor_item_3_region)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In item_1 basket_1_contain_region)
         (In item_2 basket_1_contain_region)
         (In item_3 basket_1_contain_region))
  )

)
